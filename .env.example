# Claude.ai Organization ID (from claude.ai URL or settings)
CLAUDE_ORG_ID=your-org-id-here

# Claude.ai session key (from browser cookies)
CLAUDE_SESSION_KEY=sk-ant-sid01-xxxxx

# Full browser cookie string for claude.ai (needed for plan usage tracking)
# Copy from browser DevTools > Application > Cookies > claude.ai
CLAUDE_COOKIE=your-full-cookie-string-here
